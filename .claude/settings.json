{
  "env": {
    "CLAUDE_PLUGIN_ROOT": "."
  },
  "permissions": {
    "allow": [
      "Bash(gh repo view *)",
      "Bash(gh pr view *)",
      "Bash(gh auth status *)",
      "Agent",
      "ToolSearch",
      "Glob",
      "Grep",
      "Read",
      "mcp__plugin_review-agent_review-agent__get_pr_info",
      "mcp__plugin_review-agent_review-agent__get_pr_diff",
      "mcp__plugin_review-agent_review-agent__get_pr_files",
      "mcp__plugin_review-agent_review-agent__get_pr_commits",
      "mcp__plugin_review-agent_review-agent__get_pr_comments",
      "mcp__plugin_review-agent_review-agent__get_file_content",
      "mcp__plugin_review-agent_review-agent__post_review_comment"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_review-agent_review-agent__post_review_comment",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[review-agent] Review posted to GitHub successfully'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
